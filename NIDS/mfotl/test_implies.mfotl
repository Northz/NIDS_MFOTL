# P implies A within 3 min eventually, A implies P within 3 min in the past

LET resA(name,id) = EXISTS a,b,c. A(name,id,a,b,c) 
IN
LET resB(name,id) = EXISTS d,e,f. B(name,id,d,e,f) 
IN
resA(name,id) AND (EVENTUALLY[1,6] resB(name,id) OR ONCE[1,6] resB(name,id))
OR 
resA(name,id) AND (EVENTUALLY[1,6] resA(name,id) OR ONCE[1,6] resA(name,id))
