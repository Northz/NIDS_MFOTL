  AND ct_state_ttl = 2
  AND ct_flw_http_mthd = 0
  AND is_ftp_login = 0
  AND ct_ftp_cmd = 0
  AND ct_srv_src > 1 AND ct_srv_src < 24
  AND ct_srv_dst > 1 AND ct_srv_dst < 19
