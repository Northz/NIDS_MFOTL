LET MAX_cnt_viol_low_freq(srcip, cnt_max) =
(
  cnt_max <- MAX cnt; srcip
  (
    viol_low_freq(srcip, _) 
    AND
    (
      ( # density count with window centered on current time point
        EXISTS centered_forward, centered_backwards.
        ( centered_backwards <- CNT i; srcip
          ( ONCE[1,40] viol_low_freq(srcip, _)
            AND tp(i)
          )
        )
        AND
        ( centered_forward <- CNT i; srcip
          ( EVENTUALLY[0,40] ONCE[0,0] viol_low_freq(srcip, _)
            AND tp(i) 
          )
        )
        AND (cnt = centered_forward + centered_backwards)
      )
      OR # density count with backwards window
      ( cnt <- CNT i; srcip
        ( EVENTUALLY[0,80] ONCE[0,0] viol_low_freq(srcip, _) 
          AND tp(i)
        )
      )
      OR # density count with forward window
      ( cnt <- CNT i; srcip
        ( ONCE[0,80] EVENTUALLY[0,0] viol_low_freq(srcip, _) 
          AND tp(i)
        )
      )
    )
  )
)
IN
