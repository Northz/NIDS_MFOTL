  )
  AND proto = "tcp"
  AND state = "FIN"
  AND dbytes > 1065 AND dbytes < 1399
  AND dloss = 2
  AND service = "-"
  AND sload > 4300.0 AND sload < 17480.0
  AND dload > 5597.0 AND dload < 22241.0
  AND (spkts = 10 OR spkts = 12)
  AND (dpkts = 8 OR dpkts = 10)
  AND NOT swin = 0
  AND NOT dwin = 0
  AND dmeansz > 115 AND dmeansz < 172
  AND tcprtt < 0.27
  AND synack < 0.15
  AND ackdat < 0.14
  AND is_sm_ips_ports = 0
  AND ct_state_ttl = 1
  AND ct_flw_http_mthd = 0
  AND is_ftp_login = 0
  AND ct_ftp_cmd = 0
  AND ct_srv_src > 2 AND ct_srv_src < 11
  AND ct_srv_dst > 2 AND ct_srv_dst < 10
  AND ct_dst_ltm > 0 AND ct_dst_ltm < 4
  AND ct_src_ltm > 0 AND ct_src_ltm < 5
