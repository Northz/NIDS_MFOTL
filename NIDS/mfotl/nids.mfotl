cnt <- CNT i; srcip, label
(
  (
    tp(1087202)
    AND
    (
      EXISTS cnt_max.
      ONCE MAX_cnt_viol_low_freq(srcip, cnt_max)
      AND flow(
        srcip,_,_,_,_,_,_,
        _,_,_,_,_,_,_,
        _,_,_,_,_,_,_,
        _,_,_,_,_,_,_,
        _,_,_,_,_,_,_,
        _,_,_,_,_,_,_,
        _,_,_,_,_,_,label
      )
      AND cnt_max > 15
      AND tp(i)
    )
    OR
    (
      EXISTS cnt_max.
      ONCE MAX_cnt_viol_analysis_others(srcip, cnt_max)
      AND flow(
        srcip,_,_,_,_,_,_,
        _,_,_,_,_,_,_,
        _,_,_,_,_,_,_,
        _,_,_,_,_,_,_,
        _,_,_,_,_,_,_,
        _,_,_,_,_,_,_,
        _,_,_,_,_,_,label
      )
      AND cnt_max > 215
      AND tp(i)
    )
    OR
    (
      EXISTS cnt_max.
      ONCE MAX_cnt_viol_analysis_TCP(srcip, cnt_max)
      AND flow(
        srcip,_,_,_,_,_,_,
        _,_,_,_,_,_,_,
        _,_,_,_,_,_,_,
        _,_,_,_,_,_,_,
        _,_,_,_,_,_,_,
        _,_,_,_,_,_,_,
        _,_,_,_,_,_,label
      )
      AND cnt_max > 23
      AND tp(i)
    )
    OR
    (
      EXISTS cnt_max.
      ONCE MAX_cnt_viol_backdoors_others(srcip, cnt_max)
      AND flow(
        srcip,_,_,_,_,_,_,
        _,_,_,_,_,_,_,
        _,_,_,_,_,_,_,
        _,_,_,_,_,_,_,
        _,_,_,_,_,_,_,
        _,_,_,_,_,_,_,
        _,_,_,_,_,_,label
      )
      AND cnt_max > 215
      AND tp(i)
    )
    OR
    (
      EXISTS cnt_max.
      ONCE MAX_cnt_viol_DoS_others(srcip, cnt_max)
      AND flow(
        srcip,_,_,_,_,_,_,
        _,_,_,_,_,_,_,
        _,_,_,_,_,_,_,
        _,_,_,_,_,_,_,
        _,_,_,_,_,_,_,
        _,_,_,_,_,_,_,
        _,_,_,_,_,_,label
