LET resA(name,id) = EXISTS a,b,c. A(name,a,id,b,c) 
IN
LET resB(name,id) = EXISTS d,e,f. B(name,d,id,e,f)
IN
LET trycnt(name, cnt_both,cnt_past,cnt_future) =
(
    (
        cnt_past <- CNT i; name
        ONCE[1,20] resB(name, _) AND tp(i)
    )
    AND
    (
        cnt_future <- CNT i; name
        EVENTUALLY[0,20] ONCE[0,0] resB(name, _) AND tp(i) 
    )
    AND (cnt_both = cnt_past + cnt_future)
)
IN
trycnt(n,b,p,f)










