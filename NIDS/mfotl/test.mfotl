LET resA(name,id) = EXISTS a,b,c. A(name,a,id,b,c) 
IN
LET resB(name,id) = EXISTS d,e,f. B(name,d,id,e,f)
IN
resA(a,b) AND tp(i) OR resA(a,b) AND tp(i)

