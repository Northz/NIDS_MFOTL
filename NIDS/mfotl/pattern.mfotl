LET resA(name,id) = EXISTS a,b,lab. A(name,id,a,b,lab) 
IN
LET resB(name,id) = EXISTS a,b,lab. B(name,id,a,b,lab)
IN
LET neighborA(vioA_cnt,name,id) =
(
  vioA_cnt <- CNT i; name, id
  (
    ( 
      ( ONCE[0,2] resA(name,id) AND tp(i) )
      OR 
      ( EVENTUALLY[0,2] ONCE[0,0] resA(name,id) AND tp(i) )
    )
  )
  AND 
  (
    ( resA(name,id)
      AND EVENTUALLY[0,5] resB(name,id)
    )
    OR
    resB(name,id)
  )
)
IN
(
  EXISTS A_cnt.
  ( 
    cnt <- CNT i; name, id, st
    (
      ONCE neighborA(A_cnt,name,id) 
      AND tp(i)
      AND (A(_,_,_,_,st) OR B(_,_,_,_,st))
      AND A_cnt > 2
    )
  ) 
)


