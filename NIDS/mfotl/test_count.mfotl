LET resA(name,id) = EXISTS a,b,c. A(name,id,a,b,c) 
IN
LET resB(name,id) = EXISTS d,e,f. B(name,id,d,e,f)
IN
# creates a stream of violations counts
LET counts(name, cnt) =
(
  ( cnt <- CNT i; name 
    ( 
      (resA(name,_) OR resB(name,_))
      AND
      ONCE[1,2] (resA(name,_) OR resB(name,_)) 
      AND tp(i) 
    )
  )
  OR
  ( cnt <- CNT i; name
    ( 
      (resA(name,_) OR resB(name,_))
      AND
      EVENTUALLY[0,2] ONCE[0,0] (resA(name,_) OR resB(name,_)) 
      AND tp(i) 
    )
  )
)
IN
counts(s,t)
