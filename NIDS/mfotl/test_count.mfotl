LET resA(name,id) = EXISTS a,b,c. A(name,id,a,b,c) 
IN
LET resB(name,id) = EXISTS d,e,f. B(name,id,d,e,f)
IN
# creates a stream of violations counts
LET counts(name, cnt) =
(
  (resA(name,_) OR resB(name,_))
  AND
  (
    # example of using parenthesis to limit the scope
    # of free variables, such that the left side arity
    # matches the LET declaration
    (
      EXISTS fst_cnt.
      ( 
        (
          fst_cnt <- CNT i; name 
          ( ONCE[1,3] (resA(name,_) OR resB(name,_)) 
            AND tp(i) 
          )
        )
        AND cnt = fst_cnt
      )
    )
    OR
    ( cnt <- CNT i; name
      ( EVENTUALLY[0,3] ONCE[0,0] (resA(name,_) OR resB(name,_)) 
        AND tp(i) 
      ) 
    )
  )
)
IN
# take max over the stream
LET max_count(name,max_cnt) =
(
  max_cnt <- MAX cnt; name counts(name,cnt)
)
IN
(
  EXISTS max_cnt.
  cnt <- CNT i; name
  (
    max_count(_,t) AND (t > 1)
    AND 
    (
      ONCE max_count(name, max_cnt)
      AND tp(i)
      AND (max_cnt > 1)
    )
  )
)


