  AND ct_srv_dst > 0 
  AND ct_dst_ltm > 0 
  AND ct_src_ltm > 0 
  AND ct_src_dport_ltm > 0 
  AND ct_dst_sport_ltm > 0 
  AND ct_dst_src_ltm > 0 

  )
  OR # UDP2
  ( 
    flow(
      srcip, _, dstip, _, proto, state, _,
      _, dbytes, _, _, _, dloss, service, 
      sload, dload, spkts, dpkts, swin, dwin, _,
      _, _, dmeansz, _, _, _, _,
      _, _, _, _, tcprtt, synack, ackdat,
      is_sm_ips_ports, ct_state_ttl, ct_flw_http_mthd, 
      is_ftp_login, ct_ftp_cmd, ct_srv_src, ct_srv_dst,
      ct_dst_ltm, ct_src_ltm, ct_src_dport_ltm, 
      ct_dst_sport_ltm, ct_dst_src_ltm, _, _
    )

  AND proto = "udp"
  AND state = "INT"
  AND dbytes = 0
  AND dloss = 0
  AND service = "dns"
  #AND sload > 767.0 AND sload < 1825537.0
  AND dload = 0.0
  AND spkts = 2
  AND dpkts = 0
  AND swin = 0
  AND dwin = 0
  AND dmeansz = 0
  AND is_sm_ips_ports = 0
  AND ct_state_ttl >= 2
  AND ct_flw_http_mthd >= 0
  AND is_ftp_login = 0
  AND ct_ftp_cmd >= 0
  AND ct_srv_src > 1 
  AND ct_srv_dst > 1 
  AND ct_dst_ltm > 0 
  AND ct_src_ltm > 0 
  AND ct_src_dport_ltm > 0 
  AND ct_dst_sport_ltm > 0 
  AND ct_dst_src_ltm > 0 

  )
)
IN
LET getcount_lowfreq(srcip, cnt_both, cnt_past, cnt_future) =
(
  (
    violation_lowfreq(srcip, _) 
    AND
    (
      ( # density count with window centered on current time point
        ( cnt_past <- CNT i; srcip
          ( ONCE[1,20] violation_lowfreq(srcip, _)
            AND tp(i)
          )
        )
        AND
        ( cnt_future <- CNT i; srcip
          ( EVENTUALLY[0,20] ONCE[0,0] violation_lowfreq(srcip, _)
            AND tp(i) 
          )
        )
        AND (cnt_both = cnt_past + cnt_future)
      )
    )
  )
)
IN
LET filter_count_lowfreq(srcip) =
(
  violation_lowfreq(srcip, _)
  AND
  (
    EXISTS cnt_both.
    getcount_lowfreq(srcip, cnt_both, _, _)
    AND (cnt_both >= 30)
  )
  OR
  (
    EXISTS cnt_past.
    getcount_lowfreq(srcip, _, cnt_past, _)
    AND (cnt_past >= 16)
  )
  OR
  (
    EXISTS cnt_future.
    getcount_lowfreq(srcip, _, _, cnt_future)
    AND (cnt_future >= 16)
  )
)
IN
LET getcount_highfreq(srcip, cnt_both, cnt_past, cnt_future) =
(
  (
    violation_highfreq(srcip, _) 
    AND
    (
      ( # density count with window centered on current time point
        ( cnt_past <- CNT i; srcip
          ( ONCE[1,20] violation_highfreq(srcip, _)
            AND tp(i)
          )
        )
        AND
        ( cnt_future <- CNT i; srcip
          ( EVENTUALLY[0,20] ONCE[0,0] violation_highfreq(srcip, _)
            AND tp(i) 
          )
        )
        AND (cnt_both = cnt_past + cnt_future)
      )
    )
  )
)
IN
LET filter_count_highfreq(srcip) =
(
  violation_highfreq(srcip, _)
  AND
  (
    EXISTS cnt_both.
    getcount_highfreq(srcip, cnt_both, _, _)
    AND (cnt_both >= 200)
  )
  OR
  (
    EXISTS cnt_past.
    getcount_highfreq(srcip, _, cnt_past, _)
    AND (cnt_past >= 110)
  )
  OR
  (
    EXISTS cnt_future.
    getcount_highfreq(srcip, _, _, cnt_future)
    AND (cnt_future >= 110)
  )
)
IN
#( filter_count_lowfreq(srcip) OR filter_count_highfreq(srcip) )
( 
  cnt <- CNT i; srcip, label
  (
    #tp(1087202)
    tp(1452843)
    AND
    (
      (
        ONCE ( filter_count_lowfreq(srcip) OR filter_count_highfreq(srcip) )
        AND flow(
          srcip,_,_,_,_,_,_,
          _,_,_,_,_,_,_,
          _,_,_,_,_,_,_,
          _,_,_,_,_,_,_,
          _,_,_,_,_,_,_,
          _,_,_,_,_,_,_,
          _,_,_,_,_,_,label
        )
        AND tp(i)
      )
    )
  )
)